# LAN Share — configuração por variáveis de ambiente.
# Copia para .env ou define no ambiente. Todos os valores têm default.
# Usa apenas números inteiros/número. PIN deve ser exatamente 6 dígitos.

# Porta onde o servidor escuta.
PORT=3000

# Interface a que ligar (0.0.0.0 = todas). Não muda para nada se quiseres só localhost.
HOST=0.0.0.0

# PIN de acesso (6 dígitos). Se vazio/ausente, é gerado aleatoriamente no arranque
# e mostrado no terminal. NUNCA fica com um valor por defeito.
# PIN=123456

# Tamanho máximo por ficheiro em MiB (>= 1024 para cumprir o critério do 1 GB).
MAX_FILE_MB=2048

# Retenção: horas até mensagens e ficheiros serem apagados automaticamente.
# Aceita fracções para testes (ex.: 0.01). 0 = nunca expirar.
RETENTION_HOURS=24

# Pasta onde ficam os ficheiros. O índice (index.json) fica na pasta-mãe.
UPLOAD_DIR=./data/files

# Espaço livre mínimo que deve sobrar em disco depois de aceitar um upload (MiB).
MIN_FREE_DISK_MB=512

# Limite de caracteres por mensagem de texto.
MAX_TEXT_LEN=2000

# Número de mensagens recentes devolvidas ao entrar.
HISTORY_LIMIT=50